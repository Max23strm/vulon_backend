# PostgreSQL
DB_SERVER=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable

# Secreto para firmar y validar tokens JWT. Definir uno propio y privado.
HASH=

# Dejar sin definir en desarrollo local para que la aplicación cargue .env.
RAILWAY_ENVIRONMENT=

# Google Calendar
# ENVIROMENT=DEV usa FILE_LOCATIONS; ENVIROMENT=PROD usa GOOGLE_CREDENTIALS_JSON.
ENVIROMENT=DEV
CALENDAR_ID=
FILE_LOCATIONS=
GOOGLE_CREDENTIALS_JSON=
